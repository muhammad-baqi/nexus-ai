# Supabase — per environment. Local dev uses the Supabase CLI's local stack (`npx supabase
# start`), not a third hosted project. See docs/DEPLOYMENT.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — NEVER expose this to the client bundle (no NEXT_PUBLIC_ prefix, ever).
SUPABASE_SERVICE_ROLE_KEY=

# The app's own base URL — http://localhost:3000 locally, the real Vercel URL per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — transactional email (verification, password reset, reminder emails, export-ready
# notices). Not required for local dev to boot; email-sending code paths degrade gracefully
# without it, but nothing will actually send.
RESEND_API_KEY=
RESEND_FROM=notifications@yourdomain.com

# Shared secret checked against the Authorization: Bearer header on requests to /api/cron/* —
# generate a random value (e.g. `openssl rand -hex 32`) and set the same value in Vercel's Cron
# configuration for that project.
CRON_SECRET=
